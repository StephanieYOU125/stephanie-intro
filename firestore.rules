rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /siteContent/{documentId} {
      // Everyone can read the published site content.
      allow read: if true;

      // IMPORTANT:
      // Replace PASTE_YOUR_FIREBASE_AUTH_UID_HERE with your own UID from:
      // Firebase Console → Authentication → Users → User UID
      allow create, update, delete: if request.auth != null
        && request.auth.uid == "PASTE_YOUR_FIREBASE_AUTH_UID_HERE";
    }
  }
}
